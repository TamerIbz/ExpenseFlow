<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ExpenseFlow</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@

    @await RenderSectionAsync("Styles", required: false)
    
    
    @* <link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/> *@
    <link rel="icon" class="logo" type="image/png" href="~/Images/Logo.png" />
    @* <img src="~/Images/Logo.png" class="logo" /> *@
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid position-relative">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ExpenseFlow</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            @* <div class="navbar-collapse collapse d-sm-inline-flex bg-white justify-content-between"> *@
            <div class="navbar-collapse collapse d-sm-inline-flex">
                @* <ul class="navbar-nav flex-grow-1 justify-content-center"> *@
                <ul class="navbar-nav position-absolute start-50 translate-middle-x">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    @* <li class="nav-item"> *@
                    @*     <a class="nav-link text-dark" asp-area="" asp-controller="Expense" asp-action="Index">Expenses</a> *@
                    @* </li> *@
                    @* <partial name="_ExpenseNavPartial"/> *@
                    @* <li class="nav-item"> *@
                    @*     <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
                    @* </li> *@
                    <partial name="_ExpenseNavPartial"/>
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
<body class="d-flex flex-column min-vh-100">
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>


@* <body class="d-flex flex-column min-vh-100">  *@
@* <main role="main" class="flex-grow-1"> *@
@*     @RenderBody() *@
@* </main> *@
<footer class="border-top footer text-muted py-3 mt-auto">
    <div class="container">
        &copy; 2026 - ExpenseFlow - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
</body>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>