<div class="text-center">
    <h1 class="display-4 fw-bold">ADMIN</h1>

    <hr/>
    <form asp-controller="Admin"
          asp-action="DeleteUserAccount"
          method="post"
          class="d-flex align-items-center gap-3">
        
        @if (TempData["DeletionAccountSuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["DeletionAccountSuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <label class="form-label mb-0">Delete User Account</label>

        @* <div> *@
        @* can change name/type both to email (will have to change param in account controller*@
        <input name="userId"
               type="text"
               class="form-control"
               placeholder="Enter user's ID"/>

        <button type="submit"
                class="btn btn-danger"
                onclick="return confirm('Are you sure you want to delete this account?');">
            Delete
        </button>
    </form>
    
    
    
    <br/>
    <form asp-controller="Admin"
          asp-action="DeleteExpense"
          method="post"
          class="d-flex align-items-center gap-3">
        
        @if (TempData["DeletionExpenseSuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["DeletionExpenseSuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <label class="form-label mb-0">Delete User's Expense</label>
        <input name="expenseId"
               type="text"
               class="form-control"
               placeholder="Enter user's expense ID"/>

        <button type="submit"
                class="btn btn-danger"
                onclick="return confirm('Are you sure you want to delete this Expense?');">
            Delete
        </button>
    </form>
</div>