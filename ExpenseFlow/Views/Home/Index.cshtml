@{
    ViewData["Title"] = "Home Page";
}

@model ExpenseFlow.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Identity;
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@* @inject SignInManager<Users> SignInManager; *@

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-background text-center">
@if(User.Identity?.IsAuthenticated == true)
{
    <div class="position-relative text-center">
        <div class="position-absolute start-0">
            <div class="d-inline-flex align-items-center bg-light border rounded-3 px-3 py-2 shadow-sm">
                <span class="fw-semibold">Hi @ViewBag.UserName 👋</span>
            </div>
            
            @* <span class="badge rounded-pill bg-light text-dark border px-3 py-2 shadow-sm"> *@
            @*     Hi @ViewBag.UserName *@
            @* </span> *@
        </div>
        <div>
            <h1 class="display-4 fw-bold">ExpenseFlow</h1>
            <label>Manage your expenses and finances here!</label>
        </div>
    </div>
    <br/>
    @* <br/> *@
    <a asp-controller="Expense" asp-action="Index" class="btn btn-primary">Overview</a>
    <a asp-controller="Expense" asp-action="CreateEditExpense" class="btn btn-secondary">Create</a>


    <div class="row text-center mb-4">
      
        <div class="col-md-4 mt-4">
            @if (Model.Expenses.Any())
            {
                <h5>Top Category</h5>
                <h3 class="mt-0">@Model.TopCategory</h3>
            }
            else
            {
                <h5>No Category</h5>
            }
        </div>

        <div class="col-md-4 mt-4">
            <h5>Total Spent</h5>
            <h3 class="mt-0">£@Model.TotalSpent</h3>
        </div>

        <div class="col-md-4 mt-4">
            <h5>This Month</h5>
            <h3 class="mt-0">£@Model.MonthTotal</h3>
        </div>
    </div>

    @if (Model.Expenses.Any())
    {
        <div class="d-flex justify-content-center mt-0">
            <div style="width: 450px; height: 350px;">
                <canvas id="expenseChart"></canvas>
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>

                const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryNames));
                const totals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryTotals));

                new Chart(document.getElementById('expenseChart'),
                    {
                        type: 'doughnut',
                        data: {
                            labels: categories,
                            datasets: [{
                                data: totals
                            }]
                        },

                        options: {
                            responsive: true,
                            maintainAspectRatio: false,

                            cutout: '60%',

                            plugins: {
                                legend: {
                                    position: 'bottom'
                                },

                                title: {
                                    display: true,
                                    text: 'Spending by Category'
                                }
                            }
                        }
                        

                    });
                

            </script>
            </div>
        </div>
    }
}
else
{
    <h1 class="display-4 fw-bold">ExpenseFlow</h1>
    <label>Please sign in to manager your expenses!</label>
    <br/>
    <br/>
    @* <a class="nav-link text-dark" *@
    @*    asp-controller="Account" *@
    @*    asp-action="Login"> *@
    @*     Login *@
    @* </a> *@
    
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
    <a asp-controller="Account" asp-action="SignUp" class="btn btn-secondary">SignUp</a>
}
</div>
