@{
    ViewData["Title"] = "Expenses";
}

@model List<Expense>

<div class="text-center">
    <h1 class="display-4">Expenses</h1>
    <br/>
    <hr/>
    <div class="d-flex justify-content-center align-items-center gap-5">
        <h3 class="mb-0">Total Expenses £@ViewBag.Expenses</h3>
        <a asp-controller="Home" asp-action="CreateEditExpense" class="btn btn-primary ">Create</a>
    </div>
    <br/>
    
    <table class="table">
        <thead> @*titles *@
        <tr>
            @* <th> *@
            @*     Id *@
            @* </th> *@
            <th>
                Title
            </th>
            <th>
                Category
            </th>
            <th>
                Amount
            </th>
            @* <th> *@
            @*     Description *@
            @* </th> *@
            <th>
                Actions
            </th>
        </tr>
        </thead>
        <tbody>
        @{
            foreach (var expense in Model)
            {
                <tr>
                    @* <td> *@
                    @*     @expense.Id *@
                    @* </td> *@
                    <td>
                        @expense.Title
                    </td>
                    <td>
                        @(expense.Category?.Name ?? "No Category")
                    </td>
                    <td>
                        £@expense.Amount
                    </td>
                    @* <td> *@
                    @*     $1$ @expense.Description #1# *@
                    @* </td> *@
                    <td>
                        <a asp-action="CreateEditExpense" asp-route-id="@expense.Id" class="me-1">Edit</a>
                        <a asp-action="DeleteExpense" asp-route-id="@expense.Id"
                           onclick="return confirm('Are you sure?');">Delete</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>